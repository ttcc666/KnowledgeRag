{
  "AI": {
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "ChatModel": "gpt-4o-mini",
    "PlannerModel": "",
    "AnswerModel": "",
    "ReviewerModel": "",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "SendEmbeddingDimensions": false
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333",
    "ApiKey": "",
    "Collection": "knowledge_chunks"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=App_Data/knowledge.db",
    "AutoMigrate": true
  },
  "Cap": {
    "Transport": "inmemory",
    "FailedRetryCount": 20,
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "ExchangeName": "knowledge-rag.cap"
    }
  },
  "Auth": {
    "Issuer": "KnowledgeRag.NonAzure",
    "Audience": "KnowledgeRag.NonAzure",
    "SigningKey": "CHANGE-ME-IN-PRODUCTION-AT-LEAST-32-CHARS",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 30,
    "AllowRegistration": true
  },
  "SecretProtection": {
    "MasterKey": "",
    "PreviousMasterKeys": [],
    "LegacyAuthSigningKeys": []
  },
  "Rag": {
    "ChunkSize": 1200,
    "ChunkOverlap": 180,
    "TopK": 5,
    "VectorCandidateCount": 30,
    "Bm25CandidateCount": 30,
    "FusionCandidateCount": 24,
    "RrfK": 60,
    "Bm25MaxCorpusChunks": 50000,
    "EmbeddingBatchSize": 16,
    "UpsertBatchSize": 32,
    "MaxUploadMegabytes": 30,
    "MaxExtractedCharacters": 2000000,
    "MaxPdfPages": 1000,
    "EnableAgentWorkflow": true,
    "EnablePlanner": true,
    "PlannerMaxQueries": 3,
    "MultiQueryTopK": 6,
    "MaxMergedEvidence": 10,
    "EnableReviewer": true,
    "ReviewerMaxRetries": 1,
    "ReviewerMinConfidence": 0.65
  },
  "Reranker": {
    "Mode": "local",
    "Model": "",
    "CandidateCount": 16,
    "MaxDocumentCharacters": 1600
  },
  "SearchBackend": {
    "Vector": "qdrant",
    "Lexical": "bm25",
    "PostgresTextSearchConfig": "simple",
    "AutoInitializeNativeIndexes": true
  },
  "Storage": {
    "Provider": "local",
    "RootPath": "App_Data"
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "Region": "us-east-1",
    "Bucket": "knowledge-rag",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "ForcePathStyle": true
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "KnowledgeRag.NonAzure",
    "OtlpEndpoint": "",
    "ConsoleExporter": false
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "AuthPermitLimit": 10,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Security": {
    "EnforceHttpsRedirection": false,
    "HstsMaxAgeDays": 180,
    "HstsIncludeSubDomains": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
