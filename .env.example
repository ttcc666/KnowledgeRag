AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_SEND_EMBEDDING_DIMENSIONS=false

# Dedicated master key for persisted AI Provider Credentials and Webhook Secrets.
# Production must set an independent random value (at least 32 bytes) from a secret store.
# Empty is only supported for development/test fallback to AUTH_SIGNING_KEY.
SECRET_PROTECTION_MASTER_KEY=
# During master-key rotation, temporarily keep the old key here until all secrets are re-saved.
SECRET_PROTECTION_PREVIOUS_MASTER_KEY_1=
SECRET_PROTECTION_PREVIOUS_MASTER_KEY_2=
# Legacy Auth signing keys are decrypt-only for secrets encrypted before the dedicated master key.
SECRET_PROTECTION_LEGACY_AUTH_SIGNING_KEY_1=
SECRET_PROTECTION_LEGACY_AUTH_SIGNING_KEY_2=

# qdrant | pgvector
SEARCH_VECTOR_BACKEND=qdrant
# bm25 | postgres_fts
SEARCH_LEXICAL_BACKEND=bm25
POSTGRES_FTS_CONFIG=simple
QDRANT_COLLECTION=knowledge_chunks

# Sqlite (default)
DATABASE_PROVIDER=Sqlite
DATABASE_CONNECTION_STRING=Data Source=/app/App_Data/knowledge.db
DATABASE_AUTO_MIGRATE=true

# PostgreSQL / pgvector example
# DATABASE_PROVIDER=PostgreSql
# DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=knowledge_rag;Username=knowledge_rag;Password=knowledge_rag_dev_password
POSTGRES_DB=knowledge_rag
POSTGRES_USER=knowledge_rag
POSTGRES_PASSWORD=knowledge_rag_dev_password

# CAP: inmemory for local/SQLite, rabbitmq for distributed production workers.
CAP_TRANSPORT=inmemory
CAP_FAILED_RETRY_COUNT=20
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=knowledge_rag
RABBITMQ_PASSWORD=knowledge_rag_dev_password
RABBITMQ_VHOST=/
CAP_EXCHANGE=knowledge-rag.cap

# Replace this example with a random secret in every deployed environment; Production rejects this placeholder.
AUTH_SIGNING_KEY=please-change-this-to-a-long-random-secret-at-least-32-characters
AUTH_ALLOW_REGISTRATION=true
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_REFRESH_TOKEN_DAYS=30

# local | s3
STORAGE_PROVIDER=local
# MinIO / S3 settings when STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=knowledge-rag
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# none | local | llm
RERANKER_MODE=local
RERANKER_MODEL=

OTEL_ENABLED=true
OTEL_SERVICE_NAME=KnowledgeRag.NonAzure
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORTER=false


# API request protections
RATE_LIMITING_PERMIT_LIMIT=120
# Stricter per-source-IP limit for login, registration and refresh-token endpoints.
RATE_LIMITING_AUTH_PERMIT_LIMIT=10
RATE_LIMITING_WINDOW_SECONDS=60
# Exact browser origins only; leave empty for same-origin deployment.
CORS_ALLOWED_ORIGIN_1=
CORS_ALLOWED_ORIGIN_2=
# Trusted reverse-proxy IPs only; do not trust arbitrary forwarded headers.
FORWARDED_HEADERS_KNOWN_PROXY_1=
FORWARDED_HEADERS_KNOWN_PROXY_2=
# Set true only when an HTTPS endpoint/forwarded-proto setup is configured.
SECURITY_ENFORCE_HTTPS_REDIRECTION=false
SECURITY_HSTS_MAX_AGE_DAYS=180
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
# Swagger UI is available in Development; enable outside Development only for a restricted network.
SWAGGER_ENABLED=false

# Upload and parser resource limits
RAG_MAX_UPLOAD_MEGABYTES=30
RAG_MAX_EXTRACTED_CHARACTERS=2000000
RAG_MAX_PDF_PAGES=1000
