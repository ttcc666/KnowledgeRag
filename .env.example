AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_SEND_EMBEDDING_DIMENSIONS=false

# qdrant | pgvector
SEARCH_VECTOR_BACKEND=qdrant
# bm25 | postgres_fts
SEARCH_LEXICAL_BACKEND=bm25
POSTGRES_FTS_CONFIG=simple
QDRANT_COLLECTION=knowledge_chunks

# Sqlite (default)
DATABASE_PROVIDER=Sqlite
DATABASE_CONNECTION_STRING=Data Source=/app/App_Data/knowledge.db
DATABASE_AUTO_MIGRATE=true

# PostgreSQL / pgvector example
# DATABASE_PROVIDER=PostgreSql
# DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=knowledge_rag;Username=knowledge_rag;Password=knowledge_rag_dev_password
POSTGRES_DB=knowledge_rag
POSTGRES_USER=knowledge_rag
POSTGRES_PASSWORD=knowledge_rag_dev_password

AUTH_SIGNING_KEY=please-change-this-to-a-long-random-secret-at-least-32-characters
AUTH_ALLOW_REGISTRATION=true
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_REFRESH_TOKEN_DAYS=30

# local | s3
STORAGE_PROVIDER=local
# MinIO / S3 settings when STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=knowledge-rag
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# none | local | llm
RERANKER_MODE=local
RERANKER_MODEL=

# OpenTelemetry OTLP (e.g. http://otel-collector:4317). Empty disables OTLP export.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=KnowledgeRag.NonAzure
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORTER=false
